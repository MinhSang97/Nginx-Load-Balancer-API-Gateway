FROM nginx:alpine

# Copy nginx configuration for production
COPY nginx-prod/nginx.conf /etc/nginx/nginx.conf
COPY nginx-prod/conf.d/ /etc/nginx/conf.d/

# Create necessary directories
RUN mkdir -p /var/log/nginx /etc/nginx/ssl

# Expose ports
EXPOSE 80 443

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
